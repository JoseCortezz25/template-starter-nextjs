# ---------------------------------------------------------------------------
# Docker Compose environment variables
#
# Copy this file to `.env` and adjust the values before running
# `docker compose up`. The container does not read these values directly;
# they are interpolated by Docker Compose from the compose.yml file.
# ---------------------------------------------------------------------------

# Port published on the host.
#
# The Next.js server always listens on port 3000 inside the container
# (`PORT` and `HOSTNAME` are set in the Dockerfile). This variable maps that
# internal port to a port on your machine.
APP_PORT=3000
