# Dependencies and build output
node_modules
.next
out
build
coverage
storybook-static

# Version control
.git
.gitignore
.github

# Local environment files (never copy secrets into the image)
.env
.env.*
!.env.example

# AI / tooling configuration (not needed at runtime)
.claude
.opencode
.agents
.fabrica-handoff
.husky
.vscode
.cursor
.atl

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Documentation and assets not required by the build
*.md
